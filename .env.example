# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/modern_kikubo"

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET="change_this_to_a_long_random_string"

# ── Server ────────────────────────────────────────────────────
PORT=5000
CLIENT_URL="http://localhost:5173"

# ── Cloudinary (image uploads) ────────────────────────────────
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Email notifications (Nodemailer + Gmail) ──────────────────
# Generate an App Password at myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on your Google account)
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASS="your_16_character_app_password"

# ── Payment (Flutterwave) ─────────────────────────────────────
# Get your secret key from https://dashboard.flutterwave.com
# Leave empty to use the mock MoMo payment flow
FLUTTERWAVE_SECRET_KEY=""
